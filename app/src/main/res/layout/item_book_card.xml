<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="6dp">

    <!-- Neumorphic card shell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_neuo_card"
        android:padding="16dp"
        android:minHeight="200dp"
        android:elevation="2dp">

        <!-- Format badge pill -->
        <TextView
            android:id="@+id/tv_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_format_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="#FF6B4C2A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            tools:text="EPUB" />

        <!-- Push content to bottom -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

        <!-- Hidden cover for Glide compatibility -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@string/library" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF2C1A08"
            android:lineSpacingMultiplier="1.2"
            tools:text="The Silent Patient" />

        <!-- Author -->
        <TextView
            android:id="@+id/tv_book_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="#FF9A8B7A"
            tools:text="Alex Michaelides" />

        <!-- Progress slider line with knob feel -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:indicatorColor="#FF6B4C2A"
            app:trackColor="#FFD4C9B8"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp"
            tools:progress="25" />

        <!-- Percentage -->
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="#FF9A8B7A"
            tools:text="25%" />

    </LinearLayout>

</LinearLayout>
