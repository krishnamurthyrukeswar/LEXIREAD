<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0EBE0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FF2C1A08"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="16dp" />

        <!-- ═══════════════════════════════════ -->
        <!--  LIVE PREVIEW — GREEN GLASS        -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_green"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:minHeight="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Preview"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF003333" />

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/font_preview_text"
                android:textSize="15sp"
                android:textColor="#FF004444"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!--  APPEARANCE — RED GLASS            -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_red"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF5C0000"
                android:layout_marginBottom="12dp" />

            <!-- App Theme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Theme"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF7A0000"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_app_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system"
                    android:textColor="#FF5C0000" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="#FF5C0000" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="#FF5C0000" />
            </RadioGroup>

            <!-- Reader Theme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reader Theme"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF7A0000"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_reader_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_light"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_dark"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_sepia"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_sepia" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_amoled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_amoled" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_custom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_custom" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Custom Colors Row -->
            <LinearLayout
                android:id="@+id/layout_custom_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_background"
                    android:textSize="13sp"
                    android:textColor="#FF5C0000"
                    android:gravity="center_vertical" />

                <View
                    android:id="@+id/view_custom_bg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/circle_color_swatch" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_text"
                    android:textSize="13sp"
                    android:textColor="#FF5C0000"
                    android:gravity="center_vertical" />

                <View
                    android:id="@+id/view_custom_text"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/circle_color_swatch" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!--  TYPOGRAPHY — PURPLE GLASS         -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_purple"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Typography"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF2C0060"
                android:layout_marginBottom="12dp" />

            <!-- Font Family -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Family"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF3D0080"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_system"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_serif"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serif" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_dyslexic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenDyslexic" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_literata"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Literata" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_merriweather"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Merriweather" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_lato"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lato" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_roboto_mono"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roboto Mono" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Font Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/font_size"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF3D0080" />

                <TextView
                    android:id="@+id/tv_font_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF2C0060"
                    tools:text="16sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_font_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="12"
                android:valueTo="32"
                android:stepSize="1"
                android:value="16"
                android:layout_marginBottom="8dp" />

            <!-- Line Spacing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/line_spacing"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF3D0080" />

                <TextView
                    android:id="@+id/tv_line_spacing_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF2C0060"
                    tools:text="1.5x" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_line_spacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1.0"
                android:valueTo="2.5"
                android:stepSize="0.1"
                android:value="1.5"
                android:layout_marginBottom="8dp" />

            <!-- Margins -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/margins"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF3D0080"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_margin_narrow"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/margin_narrow" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_margin_normal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/margin_normal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_margin_wide"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/margin_wide" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_margin_extra_wide"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/margin_extra_wide" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Text Alignment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_alignment"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF3D0080"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_alignment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_align_left"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/align_left" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_align_justified"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/align_justified" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!--  READING — YELLOW GLASS            -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_yellow"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF5C3D00"
                android:layout_marginBottom="12dp" />

            <!-- Scroll Direction -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll Direction"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF7A5200"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scroll_horizontal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scroll_horizontal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_scroll_vertical"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scroll_vertical" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Page Turn Animation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page Turn Animation"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF7A5200"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_anim_curl"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animation_curl" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_anim_slide"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animation_slide" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_anim_fade"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animation_fade" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_anim_none"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animation_none" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Brightness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brightness"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF7A5200" />

                <TextView
                    android:id="@+id/tv_brightness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF5C3D00"
                    tools:text="System" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100"
                android:stepSize="5"
                android:value="0"
                android:layout_marginBottom="12dp" />

            <!-- Toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/keep_screen_awake"
                    android:textColor="#FF5C3D00" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_keep_awake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/volume_buttons"
                    android:textColor="#FF5C3D00" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_volume_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!--  ABOUT — BLUE GLASS                -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_blue"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF00008B"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF00008B"
                android:padding="4dp"
                android:layout_marginBottom="8dp"
                tools:text="Version 1.0.0" />

            <TextView
                android:id="@+id/tv_rate_us"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rate_us"
                android:textColor="#FF00008B"
                android:padding="4dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="#FF00008B"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Sign Out -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_out"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sign_out"
            android:textColor="?attr/colorError" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
